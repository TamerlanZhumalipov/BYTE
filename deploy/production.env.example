# Copy to .env on the server; replace placeholders before starting.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_KEY_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=course.example.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://course.example.kz
DJANGO_TRUST_PROXY=1
DJANGO_DB_PATH=/srv/byte-data/db.sqlite3
BYTE_JUDGE_BACKEND=docker
BYTE_JUDGE_IMAGE=byte-judge:local
AI_ENABLED=0
# Enable AI only after configuring its API key and reviewing data disclosure.
# GEMINI_API_KEY=
